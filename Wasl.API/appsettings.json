{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Your Connection String",
    "Redis": "localhost:6379,abortConnect=false"

  },
  "JWT": {
    "Key": "Your Secret key at least 32 char",
    "Issuer": "Your issuer name",
    "Audience": "Your audience name",
    "AccessTokenValidityInMinutes": 30,
    "RefreshTokenValidityInDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:4200",
    "https://mydomain.com"
  ],
  "MailSettings": {
    "EmailFrom": "noreply@yourdomain.com",
    "DisplayName": "Wasl System",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUser": "your-email@gmail.com",
    "SmtpPass": "your-app-password"
  },

  "Testing": {
    "BypassOtp": true,
    "BypassDomain": "@test.com",
    "FixedOtpCode": "000000"
  },
  "DomainUrl": "https://localhost:7231",

  "RidePricingSettings": {
    "BaseFare": 1000,
    "PerKmRate": 250,
    "PerMinuteRate": 50,
    "MinimumFare": 2000,
    "AverageCitySpeedKmh": 40.0
  },
  "DefaultAdmin": {
    "Email": "admin@wasl.com",
    "Password": "ChangeThisPassword123!"
  }

}
